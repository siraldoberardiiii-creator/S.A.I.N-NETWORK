import micro_splitter
import cloud_net

def boot_universal():
    print("==================================================")
    print("   S.A.I.N. UNIVERSAL NODE BOOT")
    print("   MODE: HARMONIC STABILIZATION")
    print("==================================================")
    
    splitter = micro_splitter.MicroSplitter()
    net = cloud_net.CloudNet()
    
    net.register_node("SECOND_NODE", "s-a-i-n-network.onrender.com")
    net.optimize_route("SECOND_NODE")
    
    print(splitter.synapse_pulse())
    
    # This forces the proactive pacing directly into the CPU
    splitter.process_1_trillion()

if __name__ == "__main__":
    boot_universal()
