class CloudNet:
    def __init__(self):
        self.address_book = {}

    def register_node(self, node_id, address):
        self.address_book[node_id] = address
        print(f"[*] Net Registry: Node {node_id} registered at {address}")

    def optimize_route(self, node_id):
        if node_id in self.address_book:
            print(f"[*] Routing through GPS direct path to {self.address_book[node_id]}")
            print("[*] Bypassing standard DNS. Latency reduced to minimum.")
            return True
        return False
