Step 2: The Library Indexer (Automated)

Instead of manually renaming 100 scrolls, we write a script that scans your B2_BRAIN folder and generates the SAIN_LIBRARY_INDEX.scroll automatically.

In Termux:

```bash
nano /storage/emulated/0/deep_search_living/SAIN_NODE/SAIN_SHELF/A1_CORE/build_library_index.py
```

Paste this:

```python
import os
import re
import sys
import datetime

sys.path.append(os.path.dirname(os.path.abspath(__file__)))
from shelf_librarian import get_shelf_path

def build_index():
    brain_path = get_shelf_path("B2")
    if not brain_path:
        print("[!] Cannot find B2_BRAIN.")
        return

    index_file = os.path.join("..", "..", "SAIN_LIBRARY_INDEX.scroll")
    scrolls = [f for f in os.listdir(brain_path) if f.endswith('.scroll')]

    print("[*] Building Library Index for {} scrolls...".format(len(scrolls)))

    with open(index_file, "w", encoding="utf-8") as out:
        out.write("##############################################################\n")
        out.write("HEADER\n")
        out.write("scroll name : SAIN_LIBRARY_INDEX\n")
        out.write("date        : {}\n".format(datetime.datetime.now().strftime("%Y-%m-%d")))
        out.write("purpose     : Master lookup table for all B2_BRAIN scrolls.\n")
        out.write("##############################################################\n\n")
        
        out.write("TRANSLATOR CALL: json\n")
        out.write("this one is json (the master library index)\n")
        out.write("**************************************************************\n")
        out.write("file name   : library_index\n")
        out.write("language    : json\n")
        out.write("coordinates : X=0, Y=2, Z=1\n")
        out.write("**************************************************************\n")
        out.write("{\n")
        out.write('  "library": {\n')

        for i, scroll in enumerate(sorted(scrolls)):
            filepath = os.path.join(brain_path, scroll)
            # Read first 1000 chars to find coordinates and purpose
            try:
                with open(filepath, 'r', encoding='utf-8', errors='ignore') as f:
                    head = f.read(1000)
                
                # Extract metadata
                coords = re.search(r'coordinates\s*:\s*(X=\d+,\s*Y=\d+)', head)
                purpose = re.search(r'purpose\s*:\s*(.+)', head)
                
                coord_str = coords.group(1) if coords else "Unknown"
                purpose_str = purpose.group(1).strip() if purpose else "No description"
                
                # Clean up string for JSON
                purpose_str = purpose_str.replace('"', '').replace('\n', ' ')
                
                comma = "," if i < len(scrolls) - 1 else ""
                out.write('    "{}": {{\n'.format(scroll))
                out.write('      "coordinates": "{}",\n'.format(coord_str))
                out.write('      "purpose": "{}"\n'.format(purpose_str))
                out.write('    }}{}\n'.format(comma))
                
            except Exception as e:
                print("[!] Error reading {}: {}".format(scroll, e))

        out.write('  }\n')
        out.write('}\n')
        out.write("**************************************************************\n")
        out.write("FOOTER: end of index - pen continues.\n")
        out.write("##############################################################\n")

    print("[+] Success! Index built at {}".format(index_file))

if __name__ == "__main__":
    build_index()
```